{
  // Every option here is either plumbing OR a rule that makes the code
  // unambiguous for humans, LLMs, and the graph builder. Resolvability is the point of
  // these rules, we want to be able build the code graph with as few unresolvable
  // edges as possible
  //
  // Deliberately absent: `paths` / `baseUrl`. Import aliases make the import graph
  // depend on config instead of on the code. Use relative imports to simplify the
  // builder's job.
  "extends": "./tsconfig.effect-settings.json",
  "compilerOptions": {
    // ── File layout (plumbing) ───────────────────────────────────────────────
    // This config is for the editor, lint and type-checking: it covers everything and emits
    // nothing. tsconfig.build.json narrows it to src for the shipped build.
    "noEmit": true,
    "allowImportingTsExtensions": true, // tests import scripts/*.ts directly under tsx; legal only with noEmit

    // ── Environment (plumbing) ───────────────────────────────────────────────
    "module": "nodenext", // real Node ESM resolution: imports mean what Node will run
    "target": "esnext",
    "lib": ["esnext"], // no DOM: accidental `window`/`document` use is a type error
    "types": ["node"], // only Node globals; stops stray @types/* leaking in

    // ── Outputs (plumbing) ───────────────────────────────────────────────────
    "sourceMap": true, // debuggable stack traces
    "declaration": true, // .d.ts for consumers
    "declarationMap": true, // go-to-definition lands in src, not .d.ts

    // ── Type strictness beyond `strict` ──────────────────────────────────────
    // `strict` written out: each flag is a visible decision with its own test. A new TypeScript
    // release can add a flag to `strict`; here it stays off until we choose it.
    "noImplicitAny": true, // every binding has a type you can see or infer: no silent `any`
    "strictNullChecks": true, // null and undefined are types: absence is handled, not assumed
    "strictFunctionTypes": true, // function parameters are checked contravariantly
    "strictBindCallApply": true, // bind/call/apply are checked against the real signature
    "strictPropertyInitialization": true, // class fields are set before use
    "strictBuiltinIteratorReturn": true, // built-in iterators return `undefined`, not `any`, when done
    "noImplicitThis": true, // `this` has a known type
    "useUnknownInCatchVariables": true, // `catch (e)` gives `unknown`: narrow before use
    "alwaysStrict": true, // emit and parse in strict mode
    "noUncheckedIndexedAccess": true, // arr[i] / record[k] are T | undefined: forces handling absence
    "exactOptionalPropertyTypes": true, // `x?: T` means absent, not `undefined`: no two-way ambiguity
    "noPropertyAccessFromIndexSignature": true, // record.foo must be record["foo"]: dynamic access looks dynamic

    // ── Dead and ambiguous code ──────────────────────────────────────────────
    "noImplicitReturns": true, // every path returns or none does
    "noImplicitOverride": true, // overriding must say so: no silent shadowing on refactor
    "noUnusedLocals": true, // dead code is graph noise and review noise
    "noUnusedParameters": true, // unused params hint at wrong signatures; prefix with _ to opt out
    "noFallthroughCasesInSwitch": true, // accidental fallthrough is a classic bug
    "allowUnreachableCode": false, // unreachable code is an error, not a hint
    "allowUnusedLabels": false, // labels are almost always typos

    // ── Module hygiene (keeps the dependency graph honest) ───────────────────
    "verbatimModuleSyntax": true, // `import type` is mandatory for types: value vs type edges are explicit
    "isolatedModules": true, // each file must be understandable alone: no cross-file type tricks
    "noUncheckedSideEffectImports": true, // `import "x"` must resolve: no silent typo'd side-effect imports
    "moduleDetection": "force", // every file is a module: no accidental globals
    "erasableSyntaxOnly": true, // bans enums, namespaces, parameter properties: types erase cleanly, runs under tsx/node as-is

    // ── Performance ──────────────────────────────────────────────────────────
    "skipLibCheck": true // don't type-check node_modules .d.ts; our code is still fully checked
  },
  "include": ["src", "scripts", "tests", "eslint-rules"],
  // Fixtures break rules and types on purpose; the test harness lints them via allowDefaultProject.
  "exclude": ["tests/fixtures"]
}
